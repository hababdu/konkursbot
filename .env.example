# Bot sozlamalari
BOT_TOKEN=123456789:AAExampleTelegramBotTokenHere
BOT_USERNAME=konkurs_bot

# Admin(lar) Telegram ID raqamlari, vergul bilan ajratilgan
ADMIN_IDS=111111111,222222222

# Ma'lumotlar bazasi
# dialect: sqlite (default, fayl asosida) yoki postgres
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Agar DB_DIALECT=postgres bo'lsa, quyidagilar ishlatiladi:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=konkurs_bot
DB_USER=postgres
DB_PASSWORD=postgres
